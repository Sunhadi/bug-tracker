# Salin file ini jadi .env.local lalu isi nilainya.
# .env.local jangan di-commit.

# Neon Postgres (Vercel Marketplace). Gunakan URL yang POOLED untuk serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Random panjang. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Vercel Blob (opsional, untuk lampiran). Tanpa ini fitur upload nonaktif.
BLOB_READ_WRITE_TOKEN=""

# Seed (dipakai npm run db:seed)
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_ROLE="admin"
SEED_PROJECT_NAME="Contoh Project"
SEED_MODULE_NAME="Umum"